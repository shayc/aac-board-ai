{
  "name": "aac-board-ai",
  "version": "1.17.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run paraglide:compile && tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --emit-ts-declarations",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky && npm run paraglide:compile"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/stylis-plugin-rtl": "^9.3.0",
    "@shayc/open-board-format": "^1.3.4",
    "@shayc/react-built-in-ai": "^0.11.5",
    "idb": "^8.0.3",
    "mrmime": "^2.0.1",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{ts,tsx})": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  }
}
