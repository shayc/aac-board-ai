{
  "name": "aac-board-ai",
  "version": "1.18.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run paraglide:compile && tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "paraglide:compile": "paraglide-js compile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pwa": "npm run build && playwright test",
    "prepare": "husky && npm run paraglide:compile"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/stylis-plugin-rtl": "^9.5.0",
    "@shayc/open-board-format": "^1.5.0",
    "@shayc/react-built-in-ai": "^0.11.6",
    "idb": "^8.0.4",
    "mrmime": "^2.0.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.1",
    "@playwright/test": "^1.65.0",
    "@types/dom-chromium-ai": "^0.0.18",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
